\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Public-artifact provenance of each reconstruction family. ``Dev BLEU-4'' is the uniform full-pool beam-3 value (\S  \ref  {sec:sanity_checks}); the released evaluator scores 13.38. ``Selection'' is the checkpoint-selection rule. The 14 paper-derived runs use NLL selection on a legacy script; the step-corrected runs match the released \texttt  {validation\_freq=14} JoeyNMT semantics (validation every 14 optimiser steps) with decoded-BLEU checkpoint selection; the joint-loss variants additionally correct the recognition-loss omission. Only recipe-faithful families support the public-recipe non-reproduction claim; the rest are diagnostic.\relax }}{10}{table.caption.18}\protected@file@percent }
\newlabel{tab:public_provenance}{{3}{10}{Public-artifact provenance of each reconstruction family. ``Dev BLEU-4'' is the uniform full-pool beam-3 value (\S \ref {sec:sanity_checks}); the released evaluator scores 13.38. ``Selection'' is the checkpoint-selection rule. The 14 paper-derived runs use NLL selection on a legacy script; the step-corrected runs match the released \texttt {validation\_freq=14} JoeyNMT semantics (validation every 14 optimiser steps) with decoded-BLEU checkpoint selection; the joint-loss variants additionally correct the recognition-loss omission. Only recipe-faithful families support the public-recipe non-reproduction claim; the rest are diagnostic.\relax }{table.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Teacher-forced and free-decode diagnostic statistics for the released evaluator and the fourteen reconstruction seeds (full table in \texttt  {results/checkpoint\_stats.json}). Teacher-forced values are on 500 randomly sampled items (seed 42, sampled without replacement; the sampling SD across 5 re-samples is $\leq $0.3 pp for token accuracy and $\leq $0.01 for NLL/tok); free-decode values are full-pool (7{,}060 train / 515 dev) under the uniform beam-3 protocol (\S  \ref  {sec:sanity_checks}). sacreBLEU \texttt  {signature: BLEU|nrefs:1|case:mixed|eff:no|tok:13a|smooth:exp|version:2.5.1} (max n-gram order 4, the default).\relax }}{11}{table.caption.21}\protected@file@percent }
\newlabel{tab:sanity_stats}{{4}{11}{Teacher-forced and free-decode diagnostic statistics for the released evaluator and the fourteen reconstruction seeds (full table in \texttt {results/checkpoint\_stats.json}). Teacher-forced values are on 500 randomly sampled items (seed 42, sampled without replacement; the sampling SD across 5 re-samples is $\leq $0.3 pp for token accuracy and $\leq $0.01 for NLL/tok); free-decode values are full-pool (7{,}060 train / 515 dev) under the uniform beam-3 protocol (\S \ref {sec:sanity_checks}). sacreBLEU \texttt {signature: BLEU|nrefs:1|case:mixed|eff:no|tok:13a|smooth:exp|version:2.5.1} (max n-gram order 4, the default).\relax }{table.caption.21}{}}
