\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Matched-subset reference sensitivity (corpus sacreBLEU, BLEU points) under the released evaluator. Primary analysis: confidence=1 subset (461 items) with original and human references computed on the \emph  {same} items. Sensitivity analysis: full 641 items. Human references: Czehmann et al.\nobreakspace  {}\cite  {czehmann2026sacred} back-translations (CC BY-NC-SA 4.0). Confidence breakdown: 461 confidence=1.0, 121 confidence=0.5, 59 confidence=0.0.\relax }}{14}{table.caption.35}\protected@file@percent }
\newlabel{tab:ref_sensitivity}{{8}{14}{Matched-subset reference sensitivity (corpus sacreBLEU, BLEU points) under the released evaluator. Primary analysis: confidence=1 subset (461 items) with original and human references computed on the \emph {same} items. Sensitivity analysis: full 641 items. Human references: Czehmann et al.~\cite {czehmann2026sacred} back-translations (CC BY-NC-SA 4.0). Confidence breakdown: 461 confidence=1.0, 121 confidence=0.5, 59 confidence=0.0.\relax }{table.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Asymmetric floor-effect control (full-641 sensitivity analysis). PURE loses a larger fraction of its score than REC across all metrics when references are replaced, so simple symmetric compression is insufficient; the asymmetry does not discriminate between reference-text defects and training-distribution alignment.\relax }}{14}{table.caption.37}\protected@file@percent }
\newlabel{tab:floor_effect}{{9}{14}{Asymmetric floor-effect control (full-641 sensitivity analysis). PURE loses a larger fraction of its score than REC across all metrics when references are replaced, so simple symmetric compression is insufficient; the asymmetry does not discriminate between reference-text defects and training-distribution alignment.\relax }{table.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-item reference-frame sensitivity on the matched 461-item confidence=1 subset (released evaluator, canonical hypotheses). Sentence-level sacreBLEU (0--100, same tokenizer/smoothing as corpus BLEU). (a) Per-item scores under original vs human references for REC (recorded test poses) and PURE (replay probe); the diagonal marks equal scores. PURE points sit high under the original reference and collapse toward the diagonal/low under the human reference, whereas REC points move less. (b) Per-item paired gap (PURE$-$REC) under original (x) vs human (y) references; the star marks the mean (sentence-level mean gap $8.11 \to 0.09$, consistent in direction with the corpus-level attenuation $10.03 \to 0.95$). Sentence-level means need not equal the corpus BLEU; the figure is descriptive and does not separate reference-text defects from lexical-coupling disruption or evaluator alignment.\relax }}{15}{figure.caption.38}\protected@file@percent }
\newlabel{fig:ref_frame_paired}{{3}{15}{Per-item reference-frame sensitivity on the matched 461-item confidence=1 subset (released evaluator, canonical hypotheses). Sentence-level sacreBLEU (0--100, same tokenizer/smoothing as corpus BLEU). (a) Per-item scores under original vs human references for REC (recorded test poses) and PURE (replay probe); the diagonal marks equal scores. PURE points sit high under the original reference and collapse toward the diagonal/low under the human reference, whereas REC points move less. (b) Per-item paired gap (PURE$-$REC) under original (x) vs human (y) references; the star marks the mean (sentence-level mean gap $8.11 \to 0.09$, consistent in direction with the corpus-level attenuation $10.03 \to 0.95$). Sentence-level means need not equal the corpus BLEU; the figure is descriptive and does not separate reference-text defects from lexical-coupling disruption or evaluator alignment.\relax }{figure.caption.38}{}}
