\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces PURE--REC gap across metrics and evaluators on PHX-public (641 sequences; canonical decoding). chrF, WER, and ROUGE-L use the official SLRTP2025 implementations. WER and NLL are sign-flipped so positive means PURE is better than REC (lower WER, lower NLL). BERTScore-F1 uses \texttt  {bert-base-multilingual-cased} (no baseline rescaling). The gap is consistently positive under the original evaluator and consistently near-zero or negative under the six primary reconstructions; the eight extension seeds show the same pattern (see main-text multiseed factorial table).\relax }}{15}{table.caption.30}\protected@file@percent }
\newlabel{tab:cross_metric_gap}{{6}{15}{PURE--REC gap across metrics and evaluators on PHX-public (641 sequences; canonical decoding). chrF, WER, and ROUGE-L use the official SLRTP2025 implementations. WER and NLL are sign-flipped so positive means PURE is better than REC (lower WER, lower NLL). BERTScore-F1 uses \texttt {bert-base-multilingual-cased} (no baseline rescaling). The gap is consistently positive under the original evaluator and consistently near-zero or negative under the six primary reconstructions; the eight extension seeds show the same pattern (see main-text multiseed factorial table).\relax }{table.caption.30}{}}
