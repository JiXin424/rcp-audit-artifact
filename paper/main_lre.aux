\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces PURE--REC gap across metrics and evaluators on PHX-public (641 sequences; canonical decoding) for the original evaluator and the \emph  {six primary} reconstructions (of fourteen; the eight extension seeds show the same near-zero/negative pattern in Table\nobreakspace  {}\ref  {tab:multiseed_factorial}). chrF, WER and ROUGE-L use the official SLRTP2025 implementations (\S  \ref  {sec:metric_protocol_alignment}). WER and NLL are sign-flipped so positive always means PURE is better than REC. BERTScore-F1 uses \texttt  {bert-base-multilingual-cased} (bert-score 0.3.13 package, whose module \texttt  {\_\_version\_\_} string reads 0.3.12; \texttt  {lang=de}, \texttt  {idf=False}, no baseline rescaling; model revision logged in the artifact); per-checkpoint BERTScore cells are in the artifact. The large reversal is consistent in direction across decoded-text metrics under the original evaluator and disappears under all six primary reconstructions; residual reconstruction signs are mixed and near zero for n-gram metrics.\relax }}{12}{table.caption.32}\protected@file@percent }
\newlabel{tab:cross_metric_gap}{{7}{12}{PURE--REC gap across metrics and evaluators on PHX-public (641 sequences; canonical decoding) for the original evaluator and the \emph {six primary} reconstructions (of fourteen; the eight extension seeds show the same near-zero/negative pattern in Table~\ref {tab:multiseed_factorial}). chrF, WER and ROUGE-L use the official SLRTP2025 implementations (\S \ref {sec:metric_protocol_alignment}). WER and NLL are sign-flipped so positive always means PURE is better than REC. BERTScore-F1 uses \texttt {bert-base-multilingual-cased} (bert-score 0.3.13 package, whose module \texttt {\_\_version\_\_} string reads 0.3.12; \texttt {lang=de}, \texttt {idf=False}, no baseline rescaling; model revision logged in the artifact); per-checkpoint BERTScore cells are in the artifact. The large reversal is consistent in direction across decoded-text metrics under the original evaluator and disappears under all six primary reconstructions; residual reconstruction signs are mixed and near zero for n-gram metrics.\relax }{table.caption.32}{}}
