\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Evidence-graded analysis registry. Rows are grouped by the role each analysis plays in the argument, not by when it was added.\relax }}{11}{table.caption.5}\protected@file@percent }
