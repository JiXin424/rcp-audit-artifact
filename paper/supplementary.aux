\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Canonical checkpoint registry. 70 planned training runs, all 70 completed training. ``Beam-3 evaluation'' means a run was beam-3 decoded on at least the development set; of these 70 runs, 43 also have a canonical PHX-public PURE--REC gap under the \S  \ref  {sec:retrieval} donor registry (the remaining 27 were beam-3 evaluated on dev only and lack a canonical PHX-public PURE--REC gap). 67 non-holdout runs have dev metrics; 52 of these are non-distillation and enter the competence gate. 43 runs have both dev BLEU-4 and PHX-public PURE--GT gap (extrapolation-eligible). Plus the released original. Each family row's columns sum to the Total row.\relax }}{12}{table.caption.7}\protected@file@percent }
\newlabel{tab:checkpoint_registry}{{3}{12}{Canonical checkpoint registry. 70 planned training runs, all 70 completed training. ``Beam-3 evaluation'' means a run was beam-3 decoded on at least the development set; of these 70 runs, 43 also have a canonical PHX-public PURE--REC gap under the \S \ref {sec:retrieval} donor registry (the remaining 27 were beam-3 evaluated on dev only and lack a canonical PHX-public PURE--REC gap). 67 non-holdout runs have dev metrics; 52 of these are non-distillation and enter the competence gate. 43 runs have both dev BLEU-4 and PHX-public PURE--GT gap (extrapolation-eligible). Plus the released original. Each family row's columns sum to the Total row.\relax }{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Path sensitivity of the donor-pool substitution decomposition under the original evaluator (common 622-query support; 10{,}000-resample query-index bootstrap CIs). S1=SEEN-PURE (7{,}060-pool, max-Jaccard), S2=SEEN-RAND640 (640-pool, max), S3=SEEN-MATCHED (7{,}060-pool, Jaccard-matched), S4=SEEN-RAND640-MATCHED (640-pool, matched), U=UNSEEN-PURE (test pool). Every ordering telescopes to the same total (A)\nobreakspace  {}$=$ S1$-$U\nobreakspace  {}$=+14.7$.\relax }}{13}{table.caption.10}\protected@file@percent }
\newlabel{tab:path_sensitivity}{{4}{13}{Path sensitivity of the donor-pool substitution decomposition under the original evaluator (common 622-query support; 10{,}000-resample query-index bootstrap CIs). S1=SEEN-PURE (7{,}060-pool, max-Jaccard), S2=SEEN-RAND640 (640-pool, max), S3=SEEN-MATCHED (7{,}060-pool, Jaccard-matched), S4=SEEN-RAND640-MATCHED (640-pool, matched), U=UNSEEN-PURE (test pool). Every ordering telescopes to the same total (A)~$=$ S1$-$U~$=+14.7$.\relax }{table.caption.10}{}}
