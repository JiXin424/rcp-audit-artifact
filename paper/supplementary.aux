\@writefile{lot}{\contentsline {table}{\numberline {S43}{\ignorespaces Cross-evaluator re-decoding of the noisy-gloss retrieval outputs (641 PHX-public keys; \S  \ref  {sec:competition_real}). Gap = noisy-gloss $-$ REC, corpus sacreBLEU-4 (flat-reference form, \S  \ref  {sec:method} protocol). Rows sum to 70 cross-evaluation decodes over 69 unique evaluators (the byte-identical \texttt  {cf\_202}/\texttt  {ls\_202} pair counted once; the panel is the 74-run gap-decode set plus the rescue run, which was never gap-decoded, so the unique count is one higher than the gap panel's 68). The realistic retrieval pipeline is roughly even with REC under the released evaluator ($-0.13$), and every non-degenerate evaluator gives a negative gap; the five degenerate checkpoints (three $\alpha {=}1.0$ distillation students, two smallest ladder fractions) decode empty or near-empty hypotheses and are excluded.\relax }}{46}{table.caption.135}\protected@file@percent }
\newlabel{tab:s11_noisy_gloss_cross_eval}{{S43}{46}{Cross-evaluator re-decoding of the noisy-gloss retrieval outputs (641 PHX-public keys; \S \ref {sec:competition_real}). Gap = noisy-gloss $-$ REC, corpus sacreBLEU-4 (flat-reference form, \S \ref {sec:method} protocol). Rows sum to 70 cross-evaluation decodes over 69 unique evaluators (the byte-identical \texttt {cf\_202}/\texttt {ls\_202} pair counted once; the panel is the 74-run gap-decode set plus the rescue run, which was never gap-decoded, so the unique count is one higher than the gap panel's 68). The realistic retrieval pipeline is roughly even with REC under the released evaluator ($-0.13$), and every non-degenerate evaluator gives a negative gap; the five degenerate checkpoints (three $\alpha {=}1.0$ distillation students, two smallest ladder fractions) decode empty or near-empty hypotheses and are excluded.\relax }{table.caption.135}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S44}{\ignorespaces Cross-evaluator re-decoding of the rebuilt USTC-MoE fixed outputs (497 of 641 PHX-public keys; \S  \ref  {sec:competition_real}). Gap = USTC-MoE $-$ REC, corpus sacreBLEU-4 (REC recomputed on the same 497 keys, hence 12.36 rather than the 641-key 12.78). The rebuild decodes far below the officially reported leaderboard score (2.42 vs.\ 12.06), so it is pipeline-equivalent but not score-equivalent to the archived submission; every non-degenerate evaluator gives a negative gap. The eight seven-correction checkpoints were cross-evaluated for the noisy-gloss system (Table\nobreakspace  {}\ref  {tab:s11_noisy_gloss_cross_eval}) but not for this rebuild. The five degenerate checkpoints (three $\alpha {=}1.0$ distillation students, two smallest ladder fractions) decode empty or near-empty hypotheses and are excluded.\relax }}{47}{table.caption.137}\protected@file@percent }
\newlabel{tab:s12_ustc_moe_cross_eval}{{S44}{47}{Cross-evaluator re-decoding of the rebuilt USTC-MoE fixed outputs (497 of 641 PHX-public keys; \S \ref {sec:competition_real}). Gap = USTC-MoE $-$ REC, corpus sacreBLEU-4 (REC recomputed on the same 497 keys, hence 12.36 rather than the 641-key 12.78). The rebuild decodes far below the officially reported leaderboard score (2.42 vs.\ 12.06), so it is pipeline-equivalent but not score-equivalent to the archived submission; every non-degenerate evaluator gives a negative gap. The eight seven-correction checkpoints were cross-evaluated for the noisy-gloss system (Table~\ref {tab:s11_noisy_gloss_cross_eval}) but not for this rebuild. The five degenerate checkpoints (three $\alpha {=}1.0$ distillation students, two smallest ladder fractions) decode empty or near-empty hypotheses and are excluded.\relax }{table.caption.137}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S45}{\ignorespaces Four-layer reproduction of the headline results from the artifact (\S  \ref  {sec:method}). Layer 1 regenerates every paper number from committed per-item decodes; Layer 2 re-executes analyses from per-checkpoint data; Layer 3 re-decodes fixed outputs from checkpoint weights; Layer 4 retrains from scratch. \texttt  {make core-audit} executes L1 only and is not an end-to-end reproduction from training data.\relax }}{47}{table.caption.139}\protected@file@percent }
\newlabel{tab:reproduction_layers}{{S45}{47}{Four-layer reproduction of the headline results from the artifact (\S \ref {sec:method}). Layer 1 regenerates every paper number from committed per-item decodes; Layer 2 re-executes analyses from per-checkpoint data; Layer 3 re-decodes fixed outputs from checkpoint weights; Layer 4 retrains from scratch. \texttt {make core-audit} executes L1 only and is not an end-to-end reproduction from training data.\relax }{table.caption.139}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S46}{\ignorespaces Per-checkpoint teacher-forced and free-decode diagnostic statistics. Teacher-forced token accuracy is the fraction of non-pad tokens where $\qopname  \relax o{arg}\qopname  \relax m{max}$ of the teacher-forced logits matches the target; free-decode BLEU uses beam-3 autoregressive decoding on the full training pool (7{,}060) and full dev set (515) under the uniform protocol. Full data in \texttt  {results/checkpoint\_stats.json}.\relax }}{48}{table.caption.144}\protected@file@percent }
\newlabel{tab:sanity_checkpoint_stats}{{S46}{48}{Per-checkpoint teacher-forced and free-decode diagnostic statistics. Teacher-forced token accuracy is the fraction of non-pad tokens where $\arg \max $ of the teacher-forced logits matches the target; free-decode BLEU uses beam-3 autoregressive decoding on the full training pool (7{,}060) and full dev set (515) under the uniform protocol. Full data in \texttt {results/checkpoint\_stats.json}.\relax }{table.caption.144}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S47}{\ignorespaces Complete retrieval $\times $ construction design matrix explored on the released evaluator. Scores are corpus-level sacreBLEU-4 (0--100) on the canonical 641-item PHX-public set (REC$=$12.78). Of the 12 retrieval--construction cells, 6 were explored, 3 are not applicable ($^a$), and 3 were not explored ($^*$, $^\dagger $); full reasons in \texttt  {results/probe\_multiplicity.json}. The headline probe (bold) was selected as the maximal-gap explored cell; its CI is post-selection descriptive. Two random-donor baselines (below the midrule) lie outside the $4\times 3$ matrix.\relax }}{49}{table.caption.149}\protected@file@percent }
