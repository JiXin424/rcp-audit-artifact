\@writefile{lot}{\contentsline {table}{\numberline {S42}{\ignorespaces Cross-evaluator re-decoding of the noisy-gloss retrieval outputs (641 PHX-public keys; \S  \ref  {sec:competition_real}). Gap = noisy-gloss $-$ REC, corpus sacreBLEU-4 (flat-reference form, \S  \ref  {sec:method} protocol). The realistic retrieval pipeline is roughly even with REC under the released evaluator ($-0.13$), and every non-degenerate evaluator gives a negative gap; the five degenerate checkpoints (three $\alpha {=}1.0$ distillation students, two smallest ladder fractions) decode empty or near-empty hypotheses and are excluded.\relax }}{41}{table.caption.132}\protected@file@percent }
\newlabel{tab:s11_noisy_gloss_cross_eval}{{S42}{41}{Cross-evaluator re-decoding of the noisy-gloss retrieval outputs (641 PHX-public keys; \S \ref {sec:competition_real}). Gap = noisy-gloss $-$ REC, corpus sacreBLEU-4 (flat-reference form, \S \ref {sec:method} protocol). The realistic retrieval pipeline is roughly even with REC under the released evaluator ($-0.13$), and every non-degenerate evaluator gives a negative gap; the five degenerate checkpoints (three $\alpha {=}1.0$ distillation students, two smallest ladder fractions) decode empty or near-empty hypotheses and are excluded.\relax }{table.caption.132}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S43}{\ignorespaces Cross-evaluator re-decoding of the rebuilt USTC-MoE fixed outputs (497 of 641 PHX-public keys; \S  \ref  {sec:competition_real}). Gap = USTC-MoE $-$ REC, corpus sacreBLEU-4. The rebuild decodes far below the officially reported leaderboard score (2.42 vs.\ 12.06), so it is pipeline-faithful but not score-faithful to the archived submission; every non-degenerate evaluator gives a negative gap. The five degenerate checkpoints (three $\alpha {=}1.0$ distillation students, two smallest ladder fractions) decode empty or near-empty hypotheses and are excluded.\relax }}{42}{table.caption.134}\protected@file@percent }
\newlabel{tab:s12_ustc_moe_cross_eval}{{S43}{42}{Cross-evaluator re-decoding of the rebuilt USTC-MoE fixed outputs (497 of 641 PHX-public keys; \S \ref {sec:competition_real}). Gap = USTC-MoE $-$ REC, corpus sacreBLEU-4. The rebuild decodes far below the officially reported leaderboard score (2.42 vs.\ 12.06), so it is pipeline-faithful but not score-faithful to the archived submission; every non-degenerate evaluator gives a negative gap. The five degenerate checkpoints (three $\alpha {=}1.0$ distillation students, two smallest ladder fractions) decode empty or near-empty hypotheses and are excluded.\relax }{table.caption.134}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S44}{\ignorespaces Four-layer reproduction of the headline results from the artifact (\S  \ref  {sec:method}). Layer 1 regenerates every paper number from committed per-item decodes; Layer 2 re-executes analyses from per-checkpoint data; Layer 3 re-decodes fixed outputs from checkpoint weights; Layer 4 retrains from scratch. \texttt  {make core-audit} executes L1 only and is not an end-to-end reproduction from training data.\relax }}{42}{table.caption.136}\protected@file@percent }
\newlabel{tab:reproduction_layers}{{S44}{42}{Four-layer reproduction of the headline results from the artifact (\S \ref {sec:method}). Layer 1 regenerates every paper number from committed per-item decodes; Layer 2 re-executes analyses from per-checkpoint data; Layer 3 re-decodes fixed outputs from checkpoint weights; Layer 4 retrains from scratch. \texttt {make core-audit} executes L1 only and is not an end-to-end reproduction from training data.\relax }{table.caption.136}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S45}{\ignorespaces Per-checkpoint teacher-forced and free-decode diagnostic statistics. Teacher-forced token accuracy is the fraction of non-pad tokens where $\qopname  \relax o{arg}\qopname  \relax m{max}$ of the teacher-forced logits matches the target; free-decode BLEU uses beam-3 autoregressive decoding on the full training pool (7{,}060) and full dev set (515) under the uniform protocol. Full data in \texttt  {results/checkpoint\_stats.json}.\relax }}{43}{table.caption.141}\protected@file@percent }
\newlabel{tab:sanity_checkpoint_stats}{{S45}{43}{Per-checkpoint teacher-forced and free-decode diagnostic statistics. Teacher-forced token accuracy is the fraction of non-pad tokens where $\arg \max $ of the teacher-forced logits matches the target; free-decode BLEU uses beam-3 autoregressive decoding on the full training pool (7{,}060) and full dev set (515) under the uniform protocol. Full data in \texttt {results/checkpoint\_stats.json}.\relax }{table.caption.141}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S46}{\ignorespaces Complete retrieval $\times $ construction design matrix explored on the released evaluator. Scores are corpus-level sacreBLEU-4 (0--100) on the canonical 641-item PHX-public set (REC$=$12.78). Of the 12 retrieval--construction cells, 6 were explored, 3 are not applicable ($^a$), and 3 were not explored ($^*$, $^\dagger $); full reasons in \texttt  {results/probe\_multiplicity.json}. The headline probe (bold) was selected as the maximal-gap explored cell; its CI is post-selection descriptive. Two random-donor baselines (below the midrule) lie outside the $4\times 3$ matrix.\relax }}{44}{table.caption.145}\protected@file@percent }
\newlabel{tab:probe_multiplicity}{{S46}{44}{Complete retrieval $\times $ construction design matrix explored on the released evaluator. Scores are corpus-level sacreBLEU-4 (0--100) on the canonical 641-item PHX-public set (REC$=$12.78). Of the 12 retrieval--construction cells, 6 were explored, 3 are not applicable ($^a$), and 3 were not explored ($^*$, $^\dagger $); full reasons in \texttt {results/probe\_multiplicity.json}. The headline probe (bold) was selected as the maximal-gap explored cell; its CI is post-selection descriptive. Two random-donor baselines (below the midrule) lie outside the $4\times 3$ matrix.\relax }{table.caption.145}{}}
