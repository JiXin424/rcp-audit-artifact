\newlabel{tab:input_permutation}{{19}{18}{Input-side pose permutation with output-equivariance (100 items). Pose tensors are shuffled \emph {before} decoding while IDs stay fixed. The equivariance column verifies $E(\text {pose}_j, \text {slot}_i) = E(\text {pose}_j, \text {slot}_j)$.\relax }{table.caption.61}{}}
