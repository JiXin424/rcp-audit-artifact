\bibcite{czehmann2026sacred}{{2}{2025}{{Czehmann et~al.}}{{Czehmann, Yazdani, Hamidullah, Nunnari, and Avramidis}}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Audit design: a fixed set of pose outputs is scored under two interventions. (a) Data and provenance: the official PHOENIX-2014T split (7{,}096/519/642) was materialized by the SLRTP2025 release as 7{,}060/515/641 poses, matching the released evaluator's training manifest (36/4/1 official records absent). (b) Fixed output conditions for one German source sentence: recorded test poses (REC), Progressive-Transformer output (PT), whole-donor copy TN-PURE (source-text token-set Jaccard, exact-normalized-text exclusion), and PT-scaffold composition TN-PTCOMP. (c) Two intervention axes: the evaluator (released, fourteen recipe reconstructions, heterogeneous diagnostic checkpoints) and the reference frame (speech-transcribed vs.\ human sign-to-text), with pose outputs and the donor registry fixed; the primary estimand is $\Delta _c=\mathrm  {BLEU}_c(\mathrm  {PURE})-\mathrm  {BLEU}_c(\mathrm  {REC})$.\relax }}{15}{figure.caption.84}\protected@file@percent }
\newlabel{fig:s4_audit_design}{{S4}{15}{Audit design: a fixed set of pose outputs is scored under two interventions. (a) Data and provenance: the official PHOENIX-2014T split (7{,}096/519/642) was materialized by the SLRTP2025 release as 7{,}060/515/641 poses, matching the released evaluator's training manifest (36/4/1 official records absent). (b) Fixed output conditions for one German source sentence: recorded test poses (REC), Progressive-Transformer output (PT), whole-donor copy TN-PURE (source-text token-set Jaccard, exact-normalized-text exclusion), and PT-scaffold composition TN-PTCOMP. (c) Two intervention axes: the evaluator (released, fourteen recipe reconstructions, heterogeneous diagnostic checkpoints) and the reference frame (speech-transcribed vs.\ human sign-to-text), with pose outputs and the donor registry fixed; the primary estimand is $\Delta _c=\mathrm {BLEU}_c(\mathrm {PURE})-\mathrm {BLEU}_c(\mathrm {REC})$.\relax }{figure.caption.84}{}}
\bibcite{slrtp2025}{{3}{2025}{{Walsh et~al.}}{{Walsh, Fish, Mercanoglu~Sincan, Lakhal, Bowden, Fox, Woll, Wu, Li, Zhao, Wang, Zhou, Li, Tang, He, Wang, Zhang, Wang, Cheng, Tasyurek, Kiziltepe, and Keles}}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Human sign-to-text references remove most of the replay advantage on the matched high-confidence subset ($n=461$; released evaluator, canonical hypotheses). (a) Corpus BLEU-4 under original vs.\ human references: REC 14.94 $\to $ 7.35, PURE 24.98 $\to $ 8.30; the gap attenuates $+10.03 \to +0.95$ (90.5\%). (b) Bootstrap distribution of the attenuation contrast (10{,}000 paired resamples; mean 9.08, 95\% CI $[7.44, 10.86]$). (c) PURE$-$REC gap under original vs.\ human references across BLEU-4, BLEU-1, and chrF. References are back-translations by a single deaf fluent L2 DGS signer\nobreakspace  {}\cite  {czehmann2026sacred}; replacement cannot distinguish reference-text defects, paraphrase shift, BLEU floor effects, or disruption of the lexical coupling.\relax }}{16}{figure.caption.85}\protected@file@percent }
\newlabel{fig:s5_ref_frame}{{S5}{16}{Human sign-to-text references remove most of the replay advantage on the matched high-confidence subset ($n=461$; released evaluator, canonical hypotheses). (a) Corpus BLEU-4 under original vs.\ human references: REC 14.94 $\to $ 7.35, PURE 24.98 $\to $ 8.30; the gap attenuates $+10.03 \to +0.95$ (90.5\%). (b) Bootstrap distribution of the attenuation contrast (10{,}000 paired resamples; mean 9.08, 95\% CI $[7.44, 10.86]$). (c) PURE$-$REC gap under original vs.\ human references across BLEU-4, BLEU-1, and chrF. References are back-translations by a single deaf fluent L2 DGS signer~\cite {czehmann2026sacred}; replacement cannot distinguish reference-text defects, paraphrase shift, BLEU floor effects, or disruption of the lexical coupling.\relax }{figure.caption.85}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces The replay advantage co-occurs with training-pool donor provenance, but provenance and similarity remain confounded. (a) Pool construction: SEEN retrieves from the 7{,}060 released training poses (median donor--reference Jaccard 0.50), UNSEEN from 640 other test poses (median 0.37), with pool-size control, Jaccard caliper, duration and word-count matching, and signer constraints; residual differences (pool size, similarity, donor reuse, training-pool exposure) remain, so the contrasts are descriptive, not causal. (b) Gaps relative to local REC: SEEN-PURE $+10.24$; UNSEEN-PURE $-4.27$ (CI $[-5.39,-3.20]$); the pool-substitution estimand $(\mathrm  {SEEN}-\mathrm  {REC})-(\mathrm  {UNSEEN}-\mathrm  {REC})=+14.51$; CROSSFIT pooled $-3.8$ (text, no CI). (c) Balanced 605-query factorial: released evaluator (star) vs.\ six-reconstruction means (circles) for the pool-provenance and similarity main effects and their interaction.\relax }}{17}{figure.caption.86}\protected@file@percent }
\newlabel{fig:s6_donor_origin}{{S6}{17}{The replay advantage co-occurs with training-pool donor provenance, but provenance and similarity remain confounded. (a) Pool construction: SEEN retrieves from the 7{,}060 released training poses (median donor--reference Jaccard 0.50), UNSEEN from 640 other test poses (median 0.37), with pool-size control, Jaccard caliper, duration and word-count matching, and signer constraints; residual differences (pool size, similarity, donor reuse, training-pool exposure) remain, so the contrasts are descriptive, not causal. (b) Gaps relative to local REC: SEEN-PURE $+10.24$; UNSEEN-PURE $-4.27$ (CI $[-5.39,-3.20]$); the pool-substitution estimand $(\mathrm {SEEN}-\mathrm {REC})-(\mathrm {UNSEEN}-\mathrm {REC})=+14.51$; CROSSFIT pooled $-3.8$ (text, no CI). (c) Balanced 605-query factorial: released evaluator (star) vs.\ six-reconstruction means (circles) for the pool-provenance and similarity main effects and their interaction.\relax }{figure.caption.86}{}}
