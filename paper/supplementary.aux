\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Pose-perturbation battery (corpus sacreBLEU, BLEU points) under the released evaluator and the best rescue checkpoint (wd0, seed 202). The TN-PURE-v1 identity column here (23.79) reflects the pre-exclusion materialization used at the time this battery was decoded; the canonical materialization gives 23.02 (gap $+10.24$). Because the battery varies the pose and re-decodes, not the donor choice, the perturbation differentials are unaffected by the materialization difference (Sup.\nobreakspace  {}N: mean $|\Delta \text  {gap}| = 0.65$, max 1.45).\relax }}{14}{table.caption.25}\protected@file@percent }
\newlabel{tab:perturbation}{{9}{14}{Pose-perturbation battery (corpus sacreBLEU, BLEU points) under the released evaluator and the best rescue checkpoint (wd0, seed 202). The TN-PURE-v1 identity column here (23.79) reflects the pre-exclusion materialization used at the time this battery was decoded; the canonical materialization gives 23.02 (gap $+10.24$). Because the battery varies the pose and re-decodes, not the donor choice, the perturbation differentials are unaffected by the materialization difference (Sup.~N: mean $|\Delta \text {gap}| = 0.65$, max 1.45).\relax }{table.caption.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Cluster-aware bootstrap for the headline PURE--REC gap (canonical \S  \ref  {sec:retrieval} registry, original refs, released-evaluator hypotheses from \texttt  {results/gap\_43\_canonical\_beam3\_items/released\_\{gt,pure\}.json}). All CIs are 10{,}000-resample sacreBLEU \texttt  {tok:13a} exp-smooth over precomputed per-item n-gram sufficient statistics. With so few clusters (especially show with only 2), these are \emph  {exploratory sensitivity checks}, not confirmatory tests. Donor reuse: 641 queries select 565 unique donors (61 donors serve more than one query; maximum reuse 6; Gini 0.11).\relax }}{15}{table.caption.27}\protected@file@percent }
\newlabel{tab:cluster_bootstrap}{{10}{15}{Cluster-aware bootstrap for the headline PURE--REC gap (canonical \S \ref {sec:retrieval} registry, original refs, released-evaluator hypotheses from \texttt {results/gap\_43\_canonical\_beam3\_items/released\_\{gt,pure\}.json}). All CIs are 10{,}000-resample sacreBLEU \texttt {tok:13a} exp-smooth over precomputed per-item n-gram sufficient statistics. With so few clusters (especially show with only 2), these are \emph {exploratory sensitivity checks}, not confirmatory tests. Donor reuse: 641 queries select 565 unique donors (61 donors serve more than one query; maximum reuse 6; Gini 0.11).\relax }{table.caption.27}{}}
